# Candidate of the v3 grouping workflow (ADR-0022): the same build, scan and publication steps of the
# profile; then the epics of the release go to QA (bb pipeline candidate-ready) and the release PR opens.
name: Candidate

on:
  push:
    branches: ['release/**']

permissions:
  contents: read

concurrency:
  group: bb-candidate-${{ github.ref_name }}
  cancel-in-progress: false

jobs:
  preparar:
    runs-on: ubuntu-24.04
    outputs:
      pular: ${{ steps.v.outputs.pular }}
      tag: ${{ steps.v.outputs.tag }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: '3.12'
      - name: Versão e número da candidata
        id: v
        run: bash .bigbang/esteira/nucleo/scripts/candidata-preparar.sh

  imagem:
    needs: preparar
    if: ${{ needs.preparar.outputs.pular != 'true' }}
    runs-on: ubuntu-24.04
    permissions:
      contents: read
      actions: read
      packages: write
    outputs:
      imagem: ${{ steps.i.outputs.imagem }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: '3.12'
      - run: bash .bigbang/esteira/nucleo/scripts/comando.sh instalar
      - name: Validar testes (Flash reutiliza CI do mesmo commit)
        run: bash .bigbang/esteira/nucleo/scripts/testes-candidata.sh
        env:
          GH_TOKEN: ${{ github.token }}
      - name: Entrar no GHCR
        run: printf '%s' "$GH_TOKEN" | docker login ghcr.io -u "$GITHUB_ACTOR" --password-stdin
        env:
          GH_TOKEN: ${{ github.token }}
      # QEMU só trabalha quando deploy.plataformas tem uma arquitetura diferente da do runner (ex.: linux/arm64).
      - uses: docker/setup-qemu-action@99012661954931238ded8c8b007157a8430204e1 # v4.4.0
      - uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4.4.1
      - name: Imagens (uma vez, por digest) e Trivy
        id: i
        run: bash .bigbang/{{gerado.artefato_construir}}
        env:
          TAG: ${{ needs.preparar.outputs.tag }}

  staging:
    concurrency:
      group: bb-staging
      cancel-in-progress: false
    needs: [preparar, imagem]
    runs-on: {{gerado.runner_deploy}}
    environment: staging
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: '3.12'
      - name: Staging pelo alvo {{entrega.alvo}} (migração, publicação, saúde, smoke, ZAP)
        run: |
          bash .bigbang/esteira/perfis/deploy/scripts/preparar-alvo.sh
          bash .bigbang/esteira/perfis/deploy/scripts/staging.sh
        env:
          IMAGEM: ${{ needs.imagem.outputs.imagem }}
{{gerado.env_alvo}}

  publicar:
    needs: [preparar, imagem, staging]
    runs-on: ubuntu-24.04
    permissions:
      contents: write
      packages: write
      id-token: write
      attestations: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: '3.12'
      - name: Entrar no GHCR
        run: printf '%s' "$GH_TOKEN" | docker login ghcr.io -u "$GITHUB_ACTOR" --password-stdin
        env:
          GH_TOKEN: ${{ github.token }}
      - name: Registro das imagens e SBOM (CycloneDX) de cada uma
        run: bash .bigbang/esteira/perfis/deploy/scripts/candidata-sbom.sh
        env:
          IMAGEM: ${{ needs.imagem.outputs.imagem }}
      # Atestados de procedência: grátis em repositório público; em privado exigem GitHub Enterprise Cloud.
      - name: Atestado de procedência das imagens
        if: ${{ github.event.repository.visibility == 'public' }}
        uses: actions/attest-build-provenance@4d101475d8b20a2381f78447822ac1eab6504dd8 # v4.2.2
        with:
          subject-checksums: candidata/imagens.sha256
      - name: Pre-release com os digests
        run: bash .bigbang/{{gerado.artefato_candidata}}
        env:
          GH_TOKEN: ${{ github.token }}
          TAG: ${{ needs.preparar.outputs.tag }}
          IMAGEM: ${{ needs.imagem.outputs.imagem }}


  candidate-ready:
    needs: [preparar, publicar]
    if: ${{ vars.PROJECT_OWNER != '' }}
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: '3.12'
      - name: Epics of the candidate into QA and the release PR
        env:
          GH_TOKEN: ${{ secrets.PROJECT_TOKEN }}
          BRANCH: ${{ github.ref_name }}
          RC_TAG: ${{ needs.preparar.outputs.tag }}
        run: python .bigbang/bin/bb.py pipeline candidate-ready --branch "$BRANCH" --rc-tag "$RC_TAG"
