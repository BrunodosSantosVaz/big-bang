# Button "Rollback" (v3): redeploys in production the image recorded in the Release of the chosen version
# (the digest in imagem.txt), never undoing a migration. Only with the owner's approval of the production
# environment; the first job leaves the approval link and steps in the run summary.
name: Rollback

on:
  workflow_dispatch:
    inputs:
      versao:
        description: 'Versão para a qual voltar (vX.Y.Z, já publicada)'
        required: true
        type: string
      simular:
        description: 'Só mostrar a imagem que voltaria'
        required: true
        type: boolean
        default: true

permissions:
  contents: read

concurrency:
  group: bb-publish
  cancel-in-progress: false

jobs:
  conferir:
    runs-on: ubuntu-24.04
    steps:
      - name: Imagem registrada na Release
        run: |
          imagem=$(gh release download "$VERSAO" --repo "$GITHUB_REPOSITORY" --pattern imagem.txt --output - | tr -d '[:space:]')
          [[ "$imagem" =~ @sha256:[0-9a-f]{64}$ ]] || { echo "::error::$VERSAO não registra um digest"; exit 1; }
          echo "Voltaria produção para $VERSAO: $imagem (migrações não são desfeitas)."
        env:
          GH_TOKEN: ${{ github.token }}
          VERSAO: ${{ inputs.versao }}
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        if: ${{ !inputs.simular }}
        with:
          persist-credentials: false
      - name: Como aprovar (link e passos para quem aprova)
        if: ${{ !inputs.simular }}
        run: bash .bigbang/esteira/nucleo/scripts/link-aprovacao.sh --resumo "Voltar produção para $VERSAO"
        env:
          GH_TOKEN: ${{ github.token }}
          VERSAO: ${{ inputs.versao }}

  voltar:
    needs: conferir
    if: ${{ !inputs.simular }}
    runs-on: {{gerado.runner_deploy}}
    environment: production
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: '3.12'
      - name: Voltar produção pelo alvo {{entrega.alvo}}
        run: |
          bash .bigbang/esteira/perfis/deploy/scripts/preparar-alvo.sh
          bash .bigbang/esteira/perfis/deploy/alvos/{{entrega.alvo}}/scripts/alvo.sh voltar producao "$VERSAO"
          bash .bigbang/esteira/perfis/deploy/alvos/{{entrega.alvo}}/scripts/alvo.sh saude producao
        env:
          GH_TOKEN: ${{ github.token }}
          VERSAO: ${{ inputs.versao }}
{{gerado.env_alvo}}
