# Button "Publish" (v3, ADR-0022/0025): the gate (every epic approved or dark behind its flag, pending acceptance
# only for dark epics, no blocking issue, candidate equal to the release head, green release PR) and the production
# checklist, documentation and CHANGELOG of the release run first and change nothing. The publication runs only
# with dry_run=false after the owner approves the production environment: merge into main, promotion of the same
# candidate (no rebuild), epics concluded, milestone closed and main returned to develop.
name: Publish

on:
  workflow_dispatch:
    inputs:
      version:
        description: 'Homologated version (x.y.z)'
        required: true
        type: string
      dry_run:
        description: 'Only check the gate'
        required: true
        type: boolean
        default: true

permissions:
  contents: read

concurrency:
  group: bb-publish
  cancel-in-progress: false

jobs:
  check:
    if: ${{ vars.PROJECT_OWNER != '' }}
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: main
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: '3.12'
      - name: Release content as data (checklist, documentation, CHANGELOG)
        env:
          GH_TOKEN: ${{ secrets.PROJECT_TOKEN }}
          VERSION: ${{ inputs.version }}
        run: |
          [[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "::error::versão inválida: use x.y.z"; exit 1; }
          git fetch -q --tags origin "release/$VERSION"
          content=$(git tag -l --sort=-v:refname | grep -E "^v${VERSION//./\\.}-rc\.[0-9]+$" | head -n 1 || true)
          git worktree add -q --detach "$RUNNER_TEMP/release" "${content:-origin/release/$VERSION}"
          python .bigbang/bin/bb.py checklist production --content-dir "$RUNNER_TEMP/release"
          python .bigbang/bin/bb.py pipeline docs --content-dir "$RUNNER_TEMP/release" --published --community
          python .bigbang/bin/bb.py --root "$RUNNER_TEMP/release" docs read CHANGELOG.md | grep -F "## [$VERSION]"
      - name: Gate (changes nothing; flags and pending tests come from the release)
        env:
          GH_TOKEN: ${{ secrets.PROJECT_TOKEN }}
          VERSION: ${{ inputs.version }}
        run: python .bigbang/bin/bb.py release publish --version "$VERSION" --dry-run --content-dir "$RUNNER_TEMP/release"
      - name: How to approve (link and steps for the approver)
        if: ${{ !inputs.dry_run }}
        env:
          VERSION: ${{ inputs.version }}
        run: bash .bigbang/esteira/nucleo/scripts/link-aprovacao.sh --resumo "Publish (version $VERSION)"

  publish:
    needs: check
    if: ${{ !inputs.dry_run }}
    runs-on: {{gerado.runner_deploy}}
    environment: production
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: main
          fetch-depth: 0
          token: ${{ secrets.PROJECT_TOKEN }}
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: '3.12'
      - name: Publish ({{delivery.profile}})
        run: |
          {{gerado.preparar_alvo}}
          [[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "::error::versão inválida: use x.y.z"; exit 1; }
          git fetch -q --tags origin "release/$VERSION"
          content=$(git tag -l --sort=-v:refname | grep -E "^v${VERSION//./\\.}-rc\.[0-9]+$" | head -n 1 || true)
          git worktree add -q --detach "$RUNNER_TEMP/release" "${content:-origin/release/$VERSION}"
          python .bigbang/bin/bb.py release publish --version "$VERSION" --content-dir "$RUNNER_TEMP/release"
        env:
          GH_TOKEN: ${{ secrets.PROJECT_TOKEN }}
          VERSION: ${{ inputs.version }}
          # deploy profile: the production server (variables and secrets of the production environment)
{{gerado.env_alvo}}
      - name: Clean deployments
        if: always()
        env:
          GH_TOKEN: ${{ secrets.PROJECT_TOKEN }}
        run: python .bigbang/bin/bb.py pipeline clean-deployments --environment production

