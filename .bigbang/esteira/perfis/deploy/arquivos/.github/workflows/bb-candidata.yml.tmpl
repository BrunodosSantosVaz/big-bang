# Candidata do perfil deploy (spec 14.4): a cada push em release/**, testes, imagens (deploy.servicos) construídas UMA
# vez para deploy.plataformas e publicadas por digest, Trivy, staging (migração, publicação, saúde, smoke e ZAP), pre-release vX.Y.Z-rc.N com o digest
# (imagem.txt), SBOM e atestado, e então épico ou bug em Homologação com o PR release -> main.
name: Candidata

on:
  push:
    branches: ['release/**']

permissions:
  contents: read

concurrency:
  group: bb-candidata-${{ github.ref_name }}
  cancel-in-progress: false

jobs:
  preparar:
    runs-on: ubuntu-24.04
    outputs:
      pular: ${{ steps.v.outputs.pular }}
      tag: ${{ steps.v.outputs.tag }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: '3.12'
      - name: Versão e número da candidata
        id: v
        run: bash .bigbang/esteira/nucleo/scripts/candidata-preparar.sh

  imagem:
    needs: preparar
    if: ${{ needs.preparar.outputs.pular != 'true' }}
    runs-on: ubuntu-24.04
    permissions:
      contents: read
      actions: read
{{gerado.artifact_permissions}}
    outputs:
      imagem: ${{ steps.i.outputs.imagem }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: '3.12'
      - run: bash .bigbang/esteira/nucleo/scripts/comando.sh instalar
      - name: Validar testes (Flash reutiliza CI do mesmo commit)
        run: bash .bigbang/esteira/nucleo/scripts/testes-candidata.sh
{{gerado.env_testes_candidata}}
{{gerado.artifact_preparacao}}
      - name: {{gerado.artifact_build_name}}
        id: i
        run: bash .bigbang/{{gerado.artefato_construir}}
{{gerado.artifact_build_env}}
{{gerado.artifact_upload}}

  staging:
    concurrency:
      group: bb-staging
      cancel-in-progress: false
    needs: [preparar, imagem]
    runs-on: {{gerado.runner_deploy}}
    environment: staging
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: '3.12'
{{gerado.artifact_download_stage}}
      - name: Staging pelo alvo {{entrega.alvo}} (migração, publicação, saúde, smoke, ZAP)
        run: |
          bash .bigbang/esteira/perfis/deploy/scripts/preparar-alvo.sh
          bash .bigbang/esteira/perfis/deploy/scripts/staging.sh
        env:
          IMAGEM: ${{ needs.imagem.outputs.imagem }}
{{gerado.env_alvo}}

  publicar:
    needs: [preparar, imagem, staging]
    runs-on: ubuntu-24.04
    permissions:
      contents: write
{{gerado.artifact_permissions_publish}}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: '3.12'
{{gerado.artifact_download_publish}}
{{gerado.artifact_registro_steps}}
      - name: Pre-release com os digests
        run: bash .bigbang/{{gerado.artefato_candidata}}
{{gerado.artifact_publish_env}}

  homologar:
    needs: [preparar, publicar]
    if: ${{ vars.PROJETO_OWNER != '' }}
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: '3.12'
      - name: Épico em Homologação e PR da release
        run: bash .bigbang/esteira/nucleo/scripts/homologar.sh
        env:
          GH_TOKEN: ${{ secrets.PROJETO_TOKEN }}
          BRANCH: ${{ github.ref_name }}
          RC_TAG: ${{ needs.preparar.outputs.tag }}
          PROJETO_OWNER: ${{ vars.PROJETO_OWNER }}
          PROJETO_PLANEJAMENTO: ${{ vars.PROJETO_PLANEJAMENTO }}
          PROJETO_BUGS: ${{ vars.PROJETO_BUGS }}
