# Botão "Publicar em produção" (spec 11.6, passo 10) para alvo AWS S3 + CloudFront (OIDC).
# "conferir" roda sempre (portão e plano, nada muda);
# "publicar" só com simular=false e depois que o dono aprova o ambiente "producao".
name: Publicar em produção

on:
  workflow_dispatch:
    inputs:
      versao:
        description: 'Versão homologada (x.y.z)'
        required: true
        type: string
      simular:
        description: 'Só conferir o portão e mostrar o plano'
        required: true
        type: boolean
        default: true

permissions:
  contents: read

concurrency:
  group: bb-publicar
  cancel-in-progress: false

env:
  VERSAO: ${{ inputs.versao }}
  PROJETO_OWNER: ${{ vars.PROJETO_OWNER }}
  PROJETO_QUADRO: ${{ vars.PROJETO_QUADRO }}
  PROJECT_NUMBER: ${{ vars.PROJECT_NUMBER }}

jobs:
  conferir:
    if: ${{ vars.PROJETO_OWNER != '' }}
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: main
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: '3.12'
      - name: Portão e plano (não altera nada)
        run: bash .bigbang/esteira/nucleo/scripts/publicar-producao.sh
        env:
          GH_TOKEN: ${{ secrets.PROJETO_TOKEN }}
          SIMULAR: 'true'
      - name: Como aprovar (link e passos para quem aprova)
        if: ${{ !inputs.simular }}
        run: bash .bigbang/esteira/nucleo/scripts/link-aprovacao.sh --resumo "Publicar em produção (versão $VERSAO)"

  testes-producao:
    needs: conferir
    if: ${{ !inputs.simular }}
    runs-on: ubuntu-24.04
    outputs:
      sha: ${{ steps.testes.outputs.sha }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: main
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: '3.12'
      - name: Suíte completa antes de produção (inclusive patches)
        id: testes
        run: bash .bigbang/esteira/nucleo/scripts/testes-producao.sh
        env:
          GH_TOKEN: ${{ github.token }}

  publicar:
    needs: [conferir, testes-producao]
    if: ${{ !inputs.simular }}
    runs-on: {{gerado.runner_deploy}}
    environment: producao
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: main
          fetch-depth: 0
          persist-credentials: false
          token: ${{ secrets.PROJETO_TOKEN }}
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: '3.12'
{{gerado.publicar_producao}}
