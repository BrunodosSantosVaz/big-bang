# Candidata do perfil deploy para alvo AWS S3 + CloudFront (spec 14.4, #180):
# Autenticação OIDC (role-to-assume), publicação de arquivos estáticos no S3 e invalidação no CloudFront.
name: Candidata

on:
  push:
    branches: ['release/**']

permissions:
  contents: read

concurrency:
  group: bb-candidata-${{ github.ref_name }}
  cancel-in-progress: false

jobs:
  preparar:
    runs-on: ubuntu-24.04
    outputs:
      pular: ${{ steps.v.outputs.pular }}
      tag: ${{ steps.v.outputs.tag }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: '3.12'
      - name: Versão e número da candidata
        id: v
        run: bash .bigbang/esteira/nucleo/scripts/candidata-preparar.sh

  imagem:
    needs: preparar
    if: ${{ needs.preparar.outputs.pular != 'true' }}
    runs-on: ubuntu-24.04
    permissions:
      contents: read
      actions: read
    outputs:
      imagem: ${{ steps.i.outputs.imagem }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: '3.12'
      - run: bash .bigbang/esteira/nucleo/scripts/comando.sh instalar
      - name: Validar testes (Flash reutiliza CI do mesmo commit)
        run: bash .bigbang/esteira/nucleo/scripts/testes-candidata.sh{{gerado.env_testes_candidata}}
      - name: Construir pacote/arquivos e manifesto SHA-256 sem credenciais
        id: i
        run: bash .bigbang/{{gerado.artefato_construir}}
      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: bb-candidata-${{ github.run_id }}
          path: candidata/
          if-no-files-found: error
          retention-days: 90

  staging:
    concurrency:
      group: bb-staging
      cancel-in-progress: false
    needs: [preparar, imagem]
    runs-on: {{gerado.runner_deploy}}
    environment: staging
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: '3.12'
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: bb-candidata-${{ github.run_id }}
          path: candidata
      - name: Autenticar na AWS via OIDC
        uses: aws-actions/configure-aws-credentials@ececac4a0913210359f1eb7dd4a942526ea9e201 # v4.1.0
        with:
          role-to-assume: ${{ secrets.AWS_ROLE_ARN }}
          aws-region: ${{ vars.AWS_REGION }}
          audience: sts.amazonaws.com
      - name: Staging pelo alvo aws (migração, publicação, saúde, smoke, ZAP)
        run: |
          bash .bigbang/esteira/perfis/deploy/scripts/preparar-alvo.sh
          bash .bigbang/esteira/perfis/deploy/scripts/staging.sh
        env:
          IMAGEM: ${{ needs.imagem.outputs.imagem }}
{{gerado.env_alvo}}

  publicar:
    needs: [preparar, imagem, staging]
    runs-on: ubuntu-24.04
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: '3.12'
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: bb-candidata-${{ github.run_id }}
          path: candidata
      - name: Pre-release com o manifesto SHA-256 e pacote
        run: bash .bigbang/{{gerado.artefato_candidata}}
        env:
          GH_TOKEN: ${{ github.token }}
          TAG: ${{ needs.preparar.outputs.tag }}
          IMAGEM: ${{ needs.imagem.outputs.imagem }}

  homologar:
    needs: [preparar, publicar]
    if: ${{ vars.PROJETO_OWNER != '' }}
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: '3.12'
      - name: Épico em Homologação e PR da release
        run: bash .bigbang/esteira/nucleo/scripts/homologar.sh
        env:
          GH_TOKEN: ${{ secrets.PROJETO_TOKEN }}
          BRANCH: ${{ github.ref_name }}
          RC_TAG: ${{ needs.preparar.outputs.tag }}
          PROJETO_OWNER: ${{ vars.PROJETO_OWNER }}
          PROJETO_QUADRO: ${{ vars.PROJETO_QUADRO }}
          PROJECT_NUMBER: ${{ vars.PROJECT_NUMBER }}
