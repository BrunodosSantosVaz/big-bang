# Botão "Voltar versão" (spec 14.4) para alvo AWS S3 + CloudFront (OIDC):
# Reimplanta em produção os arquivos estáticos da versão escolhida (sem alteração de banco de dados).
name: Voltar versão

on:
  workflow_dispatch:
    inputs:
      versao:
        description: 'Versão para a qual voltar (vX.Y.Z, já publicada)'
        required: true
        type: string
      simular:
        description: 'Só mostrar o que voltaria'
        required: true
        type: boolean
        default: true

permissions:
  contents: read

concurrency:
  group: bb-publicar
  cancel-in-progress: false

jobs:
  conferir:
    outputs:
      imagem: ${{ steps.imagem.outputs.imagem }}
    runs-on: ubuntu-24.04
    steps:
      - name: Arquivos estáticos registrados na Release
        id: imagem
        run: |
          echo "imagem=v${VERSAO#v}" >> "$GITHUB_OUTPUT"
          echo "Voltaria produção estática para $VERSAO."
        env:
          GH_TOKEN: ${{ github.token }}
          VERSAO: ${{ inputs.versao }}
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        if: ${{ !inputs.simular }}
        with:
          persist-credentials: false
      - name: Como aprovar (link e passos para quem aprova)
        if: ${{ !inputs.simular }}
        run: bash .bigbang/esteira/nucleo/scripts/link-aprovacao.sh --resumo "Voltar produção para $VERSAO"
        env:
          GH_TOKEN: ${{ github.token }}
          VERSAO: ${{ inputs.versao }}

  voltar:
    needs: conferir
    if: ${{ !inputs.simular }}
    runs-on: {{gerado.runner_deploy}}
    environment: producao
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: '3.12'
{{gerado.voltar_producao}}
